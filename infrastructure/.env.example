# =============================================================================
# ThreatFlow Enterprise SOAR - Environment Variables
# Copy this file to .env and fill in all CHANGE_ME values before first run.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# THREAT INTELLIGENCE API KEYS
# -----------------------------------------------------------------------------

# VirusTotal API key - https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=CHANGE_ME  # CHANGE_ME

# AbuseIPDB API key - https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=CHANGE_ME  # CHANGE_ME

# -----------------------------------------------------------------------------
# WAZUH INDEXER (OpenSearch) CREDENTIALS
# -----------------------------------------------------------------------------

# Admin username for the OpenSearch indexer (default: admin)
WAZUH_INDEXER_USERNAME=admin

# Admin password for the OpenSearch indexer — must be strong (12+ chars, mixed case, numbers, symbols)
WAZUH_INDEXER_PASSWORD=CHANGE_ME  # CHANGE_ME

# Kibana server user for the Wazuh Dashboard
WAZUH_DASHBOARD_USERNAME=kibanaserver

# Kibana server password for the Wazuh Dashboard
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME  # CHANGE_ME

# JVM heap size limits for the Wazuh Indexer
WAZUH_INDEXER_HEAP_MIN=1g
WAZUH_INDEXER_HEAP_MAX=1g

# -----------------------------------------------------------------------------
# WAZUH MANAGER / API CREDENTIALS
# -----------------------------------------------------------------------------

# Wazuh REST API username (used by Dashboard and integrations)
WAZUH_API_USERNAME=wazuh-wui

# Wazuh REST API password
WAZUH_API_PASSWORD=CHANGE_ME  # CHANGE_ME

# -----------------------------------------------------------------------------
# THEHIVE CREDENTIALS & CONFIGURATION
# -----------------------------------------------------------------------------

# TheHive admin username
THEHIVE_ADMIN_USERNAME=admin@thehive.local

# TheHive admin password
THEHIVE_ADMIN_PASSWORD=CHANGE_ME  # CHANGE_ME

# TheHive application secret — generate with: openssl rand -hex 32
THEHIVE_SECRET=CHANGE_ME  # CHANGE_ME

# TheHive API key (generated after first login for integrations)
THEHIVE_API_KEY=CHANGE_ME  # CHANGE_ME

# TheHive JVM heap settings
THEHIVE_HEAP_MIN=512m
THEHIVE_HEAP_MAX=1g

# -----------------------------------------------------------------------------
# CORTEX CONFIGURATION
# -----------------------------------------------------------------------------

# Cortex application secret — generate with: openssl rand -hex 32
CORTEX_SECRET=CHANGE_ME  # CHANGE_ME

# Cortex JVM heap settings
CORTEX_HEAP_MIN=256m
CORTEX_HEAP_MAX=512m

# -----------------------------------------------------------------------------
# SHUFFLE SOAR CONFIGURATION
# -----------------------------------------------------------------------------

# Shuffle admin username (created on first start)
SHUFFLE_ADMIN_USERNAME=admin

# Shuffle admin password
SHUFFLE_ADMIN_PASSWORD=CHANGE_ME  # CHANGE_ME

# Shuffle admin API key (auto-generated or set manually)
SHUFFLE_ADMIN_APIKEY=CHANGE_ME  # CHANGE_ME

# Shuffle encryption modifier — generate with: openssl rand -hex 32
SHUFFLE_ENCRYPTION_KEY=CHANGE_ME  # CHANGE_ME

# Shuffle organisation identifier
SHUFFLE_ORG_ID=ThreatFlow

# -----------------------------------------------------------------------------
# CASSANDRA DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Cassandra cluster name (cosmetic, used in JMX)
CASSANDRA_CLUSTER_NAME=ThreatFlowCluster

# Cassandra username (default is "cassandra" for single-node)
CASSANDRA_USERNAME=cassandra

# Cassandra password
CASSANDRA_PASSWORD=CHANGE_ME  # CHANGE_ME

# Cassandra JVM heap size
CASSANDRA_HEAP_SIZE=1G

# -----------------------------------------------------------------------------
# ELASTICSEARCH (TheHive Indexing) CONFIGURATION
# -----------------------------------------------------------------------------

# Elasticsearch built-in elastic user password
ELASTICSEARCH_PASSWORD=CHANGE_ME  # CHANGE_ME

# Elasticsearch JVM heap sizes
ELASTICSEARCH_HEAP_MIN=512m
ELASTICSEARCH_HEAP_MAX=512m

# -----------------------------------------------------------------------------
# MINIO OBJECT STORAGE
# -----------------------------------------------------------------------------

# MinIO root (admin) username
MINIO_ROOT_USER=minioadmin  # CHANGE_ME (use a non-default value in production)

# MinIO root (admin) password — min 8 characters
MINIO_ROOT_PASSWORD=CHANGE_ME  # CHANGE_ME

# MinIO bucket for TheHive attachments (created automatically on first run)
MINIO_THEHIVE_BUCKET=thehive

# -----------------------------------------------------------------------------
# ACTIVE DIRECTORY / LDAP INTEGRATION (Containment)
# -----------------------------------------------------------------------------

# LDAP server URI (e.g., ldap://dc01.corp.local or ldaps://dc01.corp.local:636)
LDAP_SERVER_URI=ldap://CHANGE_ME  # CHANGE_ME

# Base DN for user searches
LDAP_BASE_DN=DC=corp,DC=local  # CHANGE_ME

# Bind DN — a service account with write permissions
LDAP_BIND_DN=CN=svc-soar,OU=ServiceAccounts,DC=corp,DC=local  # CHANGE_ME

# Bind account password
LDAP_BIND_PASSWORD=CHANGE_ME  # CHANGE_ME

# OU where user accounts live
LDAP_USER_OU=OU=Users,DC=corp,DC=local  # CHANGE_ME

# -----------------------------------------------------------------------------
# MICROSOFT GRAPH / EWS EMAIL CONFIGURATION (Email Quarantine)
# -----------------------------------------------------------------------------

# Microsoft 365 tenant ID
MS365_TENANT_ID=CHANGE_ME  # CHANGE_ME

# App registration client ID (needs Mail.ReadWrite, User.ReadWrite.All)
MS365_CLIENT_ID=CHANGE_ME  # CHANGE_ME

# App registration client secret
MS365_CLIENT_SECRET=CHANGE_ME  # CHANGE_ME

# Target Exchange admin email (for EWS impersonation fallback)
EWS_ADMIN_EMAIL=soar-svc@corp.local  # CHANGE_ME

# -----------------------------------------------------------------------------
# EMAIL / SMTP NOTIFICATION SETTINGS
# -----------------------------------------------------------------------------

# SMTP relay hostname
SMTP_HOST=smtp.corp.local  # CHANGE_ME

# SMTP port (587 for STARTTLS, 465 for SMTPS)
SMTP_PORT=587

# SMTP authentication username
SMTP_USERNAME=soar-notify@corp.local  # CHANGE_ME

# SMTP authentication password
SMTP_PASSWORD=CHANGE_ME  # CHANGE_ME

# Whether to use TLS (true/false)
SMTP_USE_TLS=true

# From address for SOC notifications
SMTP_FROM=ThreatFlow SOAR <soar-notify@corp.local>  # CHANGE_ME

# Default recipient for high-severity alerts
ALERT_EMAIL_TO=soc-team@corp.local  # CHANGE_ME

# -----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# -----------------------------------------------------------------------------

# External FQDN/IP of the SOC server (used in alert links)
SOC_HOST=soc.corp.local  # CHANGE_ME

# Protocol for external links (http or https)
SOC_PROTOCOL=https

# Proxy settings for containers that need internet access (leave empty to disable)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,wazuh-manager,wazuh-indexer,thehive,cortex,elasticsearch,cassandra,minio

# -----------------------------------------------------------------------------
# AUTOMATED RESPONSE ENGINE SETTINGS
# -----------------------------------------------------------------------------

# Set to "true" to enable dry-run mode — no real actions are taken, all actions are logged only
DRY_RUN=false

# Analyst ID used as default for unattended automated actions (audit trail)
AUTOMATED_ANALYST_ID=soar-engine

# Path to the containment audit log file (inside container / on host if mounted)
CONTAINMENT_AUDIT_LOG=/var/log/threatflow/containment_audit.log

# Path to forensic evidence storage root
EVIDENCE_STORAGE_PATH=/opt/threatflow/evidence

# Firewall target chain for automated IP blocks
FIREWALL_CHAIN=THREATFLOW_BLOCK

# Wazuh Active Response timeout (seconds) for host isolation commands
WAZUH_AR_TIMEOUT=60

# Whether containment actions require dual-approval (true/false)
REQUIRE_DUAL_APPROVAL=false

# TheHive case status required before rollback is permitted
ROLLBACK_REQUIRED_STATUS=Resolved
