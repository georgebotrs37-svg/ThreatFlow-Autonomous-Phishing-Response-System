<?xml version="1.0" encoding="UTF-8"?>
<!--
  ThreatFlow SOAR - Custom Wazuh Phishing Detection Rules
  Author:  ThreatFlow Detection Engineering
  Version: 1.0.0
  Updated: 2026-11-13

  Rule ID Range: 100100 – 100130
  Purpose: Detect phishing-related TTPs across the full attack chain:
           Initial Access → Execution → Persistence → Credential Access → C2

  References:
    - MITRE ATT&CK Enterprise: https://attack.mitre.org/
    - Wazuh Rules Syntax: https://documentation.wazuh.com/current/user-manual/ruleset/
    - Sysmon Event IDs:   https://docs.microsoft.com/en-us/sysinternals/downloads/sysmon

  Decoder dependency: wazuh-sysmon (bundled with Wazuh 4.x)
-->

<group name="phishing,sysmon,threatflow">

  <!-- ============================================================
       SECTION 1 — Sysmon Event ID 1 (Process Creation)
       Suspicious child processes spawned by email clients
       MITRE: T1566 (Phishing), T1204 (User Execution)
       ============================================================ -->

  <rule id="100100" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.parentImage" type="pcre2">(?i)(OUTLOOK\.EXE|THUNDERBIRD\.EXE|MSEDGE\.EXE|WINMAIL\.EXE)</field>
    <field name="sysmon.image" type="pcre2">(?i)(cmd\.exe|powershell\.exe|wscript\.exe|cscript\.exe|mshta\.exe|regsvr32\.exe|rundll32\.exe|certutil\.exe|bitsadmin\.exe)</field>
    <description>Phishing - Email client spawned suspicious child process: $(sysmon.image)</description>
    <group>phishing,execution,initial_access,</group>
    <mitre>
      <id>T1566.001</id>
      <id>T1204.002</id>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100101" level="13">
    <if_rule>100100</if_rule>
    <field name="sysmon.image" type="pcre2">(?i)(powershell\.exe|pwsh\.exe)</field>
    <field name="sysmon.commandLine" type="pcre2">(?i)(-enc|-encodedcommand|-nop|-windowstyle\s+hidden|iex|invoke-expression|downloadstring|webclient|bypass)</field>
    <description>Phishing - Email client spawned encoded/obfuscated PowerShell: $(sysmon.commandLine)</description>
    <group>phishing,execution,defense_evasion,high_confidence,</group>
    <mitre>
      <id>T1566.001</id>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>

  <rule id="100102" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.parentImage" type="pcre2">(?i)(WINWORD\.EXE|EXCEL\.EXE|POWERPNT\.EXE|ONENOTE\.EXE)</field>
    <field name="sysmon.image" type="pcre2">(?i)(cmd\.exe|powershell\.exe|wscript\.exe|cscript\.exe|mshta\.exe|regsvr32\.exe|rundll32\.exe)</field>
    <description>Phishing - Office macro execution: $(sysmon.parentImage) spawned $(sysmon.image)</description>
    <group>phishing,execution,macro_execution,</group>
    <mitre>
      <id>T1566.001</id>
      <id>T1059</id>
      <id>T1137</id>
    </mitre>
  </rule>

  <rule id="100103" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.parentImage" type="pcre2">(?i)(WINWORD\.EXE|EXCEL\.EXE|POWERPNT\.EXE)</field>
    <field name="sysmon.image" type="pcre2">(?i)(powershell\.exe|pwsh\.exe)</field>
    <field name="sysmon.commandLine" type="pcre2">(?i)(downloadfile|downloadstring|invoke-webrequest|iwr|curl|wget|bitstransfer)</field>
    <description>Phishing - Office application downloading payload via PowerShell: $(sysmon.commandLine)</description>
    <group>phishing,execution,macro_execution,download,high_confidence,</group>
    <mitre>
      <id>T1566.001</id>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100104" level="11">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.parentImage" type="pcre2">(?i)(WINWORD\.EXE|EXCEL\.EXE|POWERPNT\.EXE|OUTLOOK\.EXE)</field>
    <field name="sysmon.image" type="pcre2">(?i)(mshta\.exe)</field>
    <description>Phishing - Office/email client spawned MSHTA (HTML Application Host): $(sysmon.commandLine)</description>
    <group>phishing,execution,defense_evasion,</group>
    <mitre>
      <id>T1218.005</id>
      <id>T1566.001</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 2 — Sysmon Event ID 11 (File Creation)
       Suspicious attachment file drops
       MITRE: T1566 (Phishing), T1204 (User Execution)
       ============================================================ -->

  <rule id="100105" level="8">
    <if_group>sysmon_event11</if_group>
    <field name="sysmon.targetFilename" type="pcre2">(?i)\.(hta|js|jse|vbs|vbe|wsf|wsh)$</field>
    <field name="sysmon.image" type="pcre2">(?i)(OUTLOOK\.EXE|THUNDERBIRD\.EXE|CHROME\.EXE|MSEDGE\.EXE|FIREFOX\.EXE)</field>
    <description>Phishing - Email/browser dropped script file: $(sysmon.targetFilename)</description>
    <group>phishing,initial_access,file_drop,</group>
    <mitre>
      <id>T1566.001</id>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <rule id="100106" level="10">
    <if_group>sysmon_event11</if_group>
    <field name="sysmon.targetFilename" type="pcre2">(?i)\.(iso|img|vhd|vhdx)$</field>
    <field name="sysmon.image" type="pcre2">(?i)(OUTLOOK\.EXE|THUNDERBIRD\.EXE|CHROME\.EXE|MSEDGE\.EXE|FIREFOX\.EXE)</field>
    <description>Phishing - Email/browser dropped disk image file (ISO smuggling): $(sysmon.targetFilename)</description>
    <group>phishing,initial_access,iso_smuggling,</group>
    <mitre>
      <id>T1566.001</id>
      <id>T1553.005</id>
    </mitre>
  </rule>

  <rule id="100107" level="9">
    <if_group>sysmon_event11</if_group>
    <field name="sysmon.targetFilename" type="pcre2">(?i)\\(AppData|Temp|Downloads)\\.*\.(exe|dll|bat|ps1|lnk)$</field>
    <field name="sysmon.image" type="pcre2">(?i)(OUTLOOK\.EXE|THUNDERBIRD\.EXE|WINWORD\.EXE|EXCEL\.EXE)</field>
    <description>Phishing - Office/email client wrote executable to user-writable path: $(sysmon.targetFilename)</description>
    <group>phishing,initial_access,file_drop,</group>
    <mitre>
      <id>T1566.001</id>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 3 — Sysmon Event ID 22 (DNS Query)
       Suspicious DNS lookups following email activity
       MITRE: T1071.004 (C2 via DNS), T1566 (Phishing)
       ============================================================ -->

  <rule id="100108" level="8">
    <if_group>sysmon_event22</if_group>
    <field name="sysmon.queryName" type="pcre2">(?i)(\.tk|\.ml|\.ga|\.cf|\.gq|bit\.ly|tinyurl\.com|rb\.gy|cutt\.ly|is\.gd|t\.co)</field>
    <field name="sysmon.image" type="pcre2">(?i)(OUTLOOK\.EXE|THUNDERBIRD\.EXE|WINWORD\.EXE|EXCEL\.EXE)</field>
    <description>Phishing - Email/Office app queried suspicious short-link/free TLD domain: $(sysmon.queryName)</description>
    <group>phishing,c2,dns,</group>
    <mitre>
      <id>T1566.002</id>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <rule id="100109" level="10">
    <if_group>sysmon_event22</if_group>
    <field name="sysmon.queryName" type="pcre2">(?i)(pastebin\.com|hastebin\.com|paste\.ee|raw\.githubusercontent\.com|transfer\.sh|filebin\.net|gofile\.io)</field>
    <field name="sysmon.image" type="pcre2">(?i)(powershell\.exe|pwsh\.exe|cmd\.exe|wscript\.exe|cscript\.exe|mshta\.exe)</field>
    <description>Phishing - Script engine queried paste/file-sharing site for payload staging: $(sysmon.queryName)</description>
    <group>phishing,c2,staging,</group>
    <mitre>
      <id>T1102</id>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100110" level="9">
    <if_group>sysmon_event22</if_group>
    <field name="sysmon.queryName" type="pcre2">(?i)([a-z0-9]{20,}\.(com|net|org|info)|[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}\.)</field>
    <field name="sysmon.image" type="pcre2">(?i)(OUTLOOK\.EXE|WINWORD\.EXE|EXCEL\.EXE|powershell\.exe)</field>
    <description>Phishing - Query to algorithmically generated / DGA-like domain: $(sysmon.queryName)</description>
    <group>phishing,c2,dga,</group>
    <mitre>
      <id>T1568.002</id>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 4 — Sysmon Event ID 3 (Network Connection)
       Unusual outbound connections post-email-open
       MITRE: T1071 (C2), T1041 (Exfiltration)
       ============================================================ -->

  <rule id="100111" level="9">
    <if_group>sysmon_event3</if_group>
    <field name="sysmon.image" type="pcre2">(?i)(WINWORD\.EXE|EXCEL\.EXE|POWERPNT\.EXE|OUTLOOK\.EXE)</field>
    <field name="sysmon.destinationPort" type="pcre2">^(4444|4445|8080|8443|1337|31337|9999|6666|1234)$</field>
    <description>Phishing - Office/email app outbound to non-standard high-risk port: $(sysmon.destinationIp):$(sysmon.destinationPort)</description>
    <group>phishing,c2,network,</group>
    <mitre>
      <id>T1071.001</id>
      <id>T1566.001</id>
    </mitre>
  </rule>

  <rule id="100112" level="10">
    <if_group>sysmon_event3</if_group>
    <field name="sysmon.image" type="pcre2">(?i)(powershell\.exe|pwsh\.exe|cmd\.exe|wscript\.exe|mshta\.exe)</field>
    <field name="sysmon.destinationPort" type="pcre2">^(80|443|8080|8443)$</field>
    <field name="sysmon.initiated">true</field>
    <description>Phishing - Script interpreter established outbound web connection: $(sysmon.image) → $(sysmon.destinationIp):$(sysmon.destinationPort)</description>
    <group>phishing,c2,network,</group>
    <mitre>
      <id>T1071.001</id>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 5 — Wazuh FIM (File Integrity Monitoring)
       Suspicious modifications in %APPDATA% after email open
       MITRE: T1547 (Boot/Logon Autostart), T1112 (Registry)
       ============================================================ -->

  <rule id="100113" level="10">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\\AppData\\(Roaming|Local)\\.*\.(exe|dll|bat|ps1|vbs|js|hta)$</field>
    <field name="changed_attributes">content,md5,sha1,sha256</field>
    <description>Phishing - FIM: Executable/script created or modified in AppData: $(file)</description>
    <group>phishing,persistence,fim,</group>
    <mitre>
      <id>T1547.001</id>
      <id>T1036</id>
    </mitre>
  </rule>

  <rule id="100114" level="11">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\</field>
    <description>Phishing - FIM: File written to Startup folder (persistence mechanism): $(file)</description>
    <group>phishing,persistence,fim,startup,</group>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 6 — Credential Access (LSASS)
       MITRE: T1003.001 (OS Credential Dumping: LSASS Memory)
       ============================================================ -->

  <rule id="100115" level="14">
    <if_group>sysmon_event10</if_group>
    <field name="sysmon.targetImage" type="pcre2">(?i)lsass\.exe</field>
    <field name="sysmon.sourceImage" type="pcre2">(?i)(?!.*\\(MsMpEng\.exe|csrss\.exe|wininit\.exe|services\.exe|lsm\.exe|svchost\.exe))</field>
    <description>Phishing - Credential Dump: Suspicious process accessed LSASS memory: $(sysmon.sourceImage)</description>
    <group>phishing,credential_access,lsass,high_confidence,</group>
    <mitre>
      <id>T1003.001</id>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100116" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.commandLine" type="pcre2">(?i)(procdump|mimikatz|sekurlsa|lsadump|wce\.exe|pwdump|gsecdump|fgdump|cachedump)</field>
    <description>Phishing - Known credential dumping tool executed: $(sysmon.commandLine)</description>
    <group>phishing,credential_access,tooling,high_confidence,</group>
    <mitre>
      <id>T1003.001</id>
      <id>T1003.002</id>
    </mitre>
  </rule>

  <rule id="100117" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.commandLine" type="pcre2">(?i)(comsvcs\.dll.*MiniDump|rundll32.*comsvcs)</field>
    <description>Phishing - LSASS dump via comsvcs.dll MiniDump (living-off-the-land): $(sysmon.commandLine)</description>
    <group>phishing,credential_access,lolbas,high_confidence,</group>
    <mitre>
      <id>T1003.001</id>
      <id>T1218.011</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 7 — Defense Evasion / LOLBas Abuse
       MITRE: T1218 (Signed Binary Proxy Execution)
       ============================================================ -->

  <rule id="100118" level="11">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.image" type="pcre2">(?i)(regsvr32\.exe|regasm\.exe|regsvcs\.exe)</field>
    <field name="sysmon.commandLine" type="pcre2">(?i)(http|scrobj\.dll|/s\s|/u\s)</field>
    <description>Phishing - Regsvr32 Squiblydoo / COM script proxy execution: $(sysmon.commandLine)</description>
    <group>phishing,defense_evasion,lolbas,</group>
    <mitre>
      <id>T1218.010</id>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100119" level="11">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.image" type="pcre2">(?i)(certutil\.exe)</field>
    <field name="sysmon.commandLine" type="pcre2">(?i)(-decode|-urlcache|-f\s+http)</field>
    <description>Phishing - Certutil used for payload download/decode (LOLBAS): $(sysmon.commandLine)</description>
    <group>phishing,defense_evasion,lolbas,download,</group>
    <mitre>
      <id>T1140</id>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 8 — ISO / VHD Mount and Execute
       MITRE: T1553.005 (Mark-of-the-Web Bypass)
       ============================================================ -->

  <rule id="100120" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.currentDirectory" type="pcre2">(?i)[D-Z]:\\</field>
    <field name="sysmon.image" type="pcre2">(?i)(cmd\.exe|powershell\.exe|wscript\.exe|mshta\.exe|rundll32\.exe)</field>
    <field name="sysmon.parentImage" type="pcre2">(?i)(explorer\.exe|dllhost\.exe)</field>
    <description>Phishing - Process launched from mounted disk image (ISO/VHD): current dir $(sysmon.currentDirectory)</description>
    <group>phishing,execution,iso_smuggling,motw_bypass,</group>
    <mitre>
      <id>T1553.005</id>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 9 — Sysmon Event ID 7 (Image Load)
       Suspicious DLLs loaded by Office applications
       MITRE: T1055 (Process Injection), T1574 (DLL Hijacking)
       ============================================================ -->

  <rule id="100121" level="10">
    <if_group>sysmon_event7</if_group>
    <field name="sysmon.image" type="pcre2">(?i)(WINWORD\.EXE|EXCEL\.EXE|POWERPNT\.EXE)</field>
    <field name="sysmon.imageLoaded" type="pcre2">(?i)\\(Temp|AppData|Downloads)\\.*\.dll$</field>
    <field name="sysmon.signed">false</field>
    <description>Phishing - Office app loaded unsigned DLL from user-writable path: $(sysmon.imageLoaded)</description>
    <group>phishing,defense_evasion,dll_sideload,</group>
    <mitre>
      <id>T1574.002</id>
      <id>T1055.001</id>
    </mitre>
  </rule>

  <!-- ============================================================
       SECTION 10 — Composite / Correlated Rules
       Multi-step phishing chain correlation
       ============================================================ -->

  <rule id="100122" level="12" timeframe="300" frequency="2">
    <if_matched_group>phishing</if_matched_group>
    <same_field>agent.id</same_field>
    <description>Phishing - Multiple phishing indicators on same endpoint within 5 minutes (composite alert)</description>
    <group>phishing,correlation,high_confidence,</group>
    <mitre>
      <id>T1566</id>
    </mitre>
  </rule>

  <rule id="100123" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.image" type="pcre2">(?i)(net\.exe|net1\.exe)</field>
    <field name="sysmon.commandLine" type="pcre2">(?i)(user\s+/add|localgroup.*administrators|user\s+/domain)</field>
    <field name="sysmon.parentImage" type="pcre2">(?i)(WINWORD\.EXE|EXCEL\.EXE|OUTLOOK\.EXE|cmd\.exe|powershell\.exe)</field>
    <description>Phishing - Lateral movement: account manipulation command executed post-phishing: $(sysmon.commandLine)</description>
    <group>phishing,privilege_escalation,lateral_movement,</group>
    <mitre>
      <id>T1136.001</id>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100124" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.image" type="pcre2">(?i)(schtasks\.exe|at\.exe)</field>
    <field name="sysmon.commandLine" type="pcre2">(?i)(/create|/sc\s|/tr\s)</field>
    <field name="sysmon.parentImage" type="pcre2">(?i)(WINWORD\.EXE|EXCEL\.EXE|OUTLOOK\.EXE|powershell\.exe|cmd\.exe|wscript\.exe)</field>
    <description>Phishing - Scheduled task created by suspicious parent (persistence): $(sysmon.commandLine)</description>
    <group>phishing,persistence,scheduled_task,</group>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <rule id="100125" level="11">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.image" type="pcre2">(?i)(reg\.exe|regedit\.exe)</field>
    <field name="sysmon.commandLine" type="pcre2">(?i)(\\CurrentVersion\\Run|\\CurrentVersion\\RunOnce|\\Winlogon|\\Image File Execution Options)</field>
    <field name="sysmon.parentImage" type="pcre2">(?i)(WINWORD\.EXE|EXCEL\.EXE|OUTLOOK\.EXE|powershell\.exe|cmd\.exe|wscript\.exe)</field>
    <description>Phishing - Registry run key modified for persistence by suspicious parent: $(sysmon.commandLine)</description>
    <group>phishing,persistence,registry,</group>
    <mitre>
      <id>T1547.001</id>
      <id>T1112</id>
    </mitre>
  </rule>

</group>
